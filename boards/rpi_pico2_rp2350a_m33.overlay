/*
 * Route Zephyr's console and the F Prime byte-stream driver through the
 * Pico 2's USB device controller. Without this overlay, zephyr,console is
 * uart0 on GPIO 0/1 and the board does not enumerate as a USB serial port.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/rpi-pico-rp2350a-pinctrl.h>

/ {
    chosen {
        zephyr,console = &cdc_acm_uart0;
    };

    /*
     * Native RP2350 power-enable outputs per the schematic GPIO breakout:
     * GPIO4-9 drivetrain, GPIO10 arm, GPIO11 science. All active-high, all
     * must come up inactive/low. GPIO13 and up are an unassigned generic
     * breakout header (DF11 18DP, CN6) with no dedicated function.
     */
    billee-gpio-outputs {
        compatible = "gpio-leds";

        drive_enable_1: drive-enable-1 { gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>; };
        drive_enable_2: drive-enable-2 { gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>; };
        drive_enable_3: drive-enable-3 { gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>; };
        drive_enable_4: drive-enable-4 { gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>; };
        drive_enable_5: drive-enable-5 { gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>; };
        drive_enable_6: drive-enable-6 { gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>; };
        arm_enable: arm-enable { gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>; };
        science_enable: science-enable { gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>; };
    };

    /*
     * E-STOP status input, GPIO12. Raw level passed straight through:
     * LOW = E-STOP engaged (stop), HIGH = released (run allowed).
     * NO internal pull of any kind: the external 10k pulldown (R61) is the
     * fail-safe, and this same net drives the first input of all 8 hardware
     * AND gates (U17/U18), so an internal pull would shift the voltage they see.
     * Never configure this pin as an output.
     */
    billee-gpio-inputs {
        compatible = "gpio-keys";

        estop_status: estop-status { gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>; };
    };

    /*
     * LittleFS on storage_partition (below), auto-mounted at /lfs before main().
     * Holds command sequences (/lfs/seq/*.bin) and the parameter database
     * (/lfs/PrmDb.dat). The first boot on a blank partition formats it.
     * cache-size matches the flash's 256-byte program page.
     */
    fstab {
        compatible = "zephyr,fstab";

        lfs_storage: lfs-storage {
            compatible = "zephyr,fstab,littlefs";
            mount-point = "/lfs";
            partition = <&storage_partition>;
            automount;
            read-size = <16>;
            prog-size = <16>;
            cache-size = <256>;
            lookahead-size = <32>;
            block-cycles = <512>;
        };
    };
};

/*
 * 4 MB QSPI flash layout: the firmware image is linked from offset 0 (~465 KB
 * today), and the last 1 MB is the LittleFS storage partition. A UF2/picotool
 * flash only rewrites the image's own blocks, so sequences and saved
 * parameters survive a reflash.
 */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        storage_partition: partition@300000 {
            label = "storage";
            reg = <0x00300000 DT_SIZE_M(1)>;
        };
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/*
 * uart0 defaults to GPIO0/1 (TX/RX), which conflicts with I2C0 below.
 * The board console and F Prime GDS transport both run over the USB CDC
 * ACM device above, so the hardware UART0 peripheral is unused.
 */
&uart0 {
    status = "disabled";
};

/*
 * Per the PDB GPIO map (Rev G): I2C0 (high-current telemetry bus, INA780x
 * via TCA4307) on GPIO0/1, I2C1 (logic/temp telemetry bus, MCP9808 via
 * TCA4307) on GPIO2/3. Both buses are enabled here at the devicetree level;
 * no F Prime I2C driver/component is wired to them yet.
 */
&i2c0_default {
    group1 {
        pinmux = <I2C0_SDA_P0>, <I2C0_SCL_P1>;
        input-enable;
        input-schmitt-enable;
    };
};

&i2c1_default {
    group1 {
        pinmux = <I2C1_SDA_P2>, <I2C1_SCL_P3>;
        input-enable;
        input-schmitt-enable;
    };
};
